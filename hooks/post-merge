#!/bin/sh
# Close the tasks named in a merge commit message.
#
# Install it by hand, never automatically:
#
#   cp hooks/post-merge .git/hooks/post-merge && chmod +x .git/hooks/post-merge
#
# A merge message holding "closes 260806-migration" flips that task to done and
# leaves a dated entry in its Log. The change is left uncommitted on purpose:
# you decide when it goes in, and `git checkout .tasks` undoes it.
#
# For that reason it belongs on a machine where a person pulls, and nowhere
# else. Never install it on an agent's clone: the uncommitted change it leaves
# makes the next `git pull --ff-only` refuse with "your local changes would be
# overwritten", and in the systemd unit that pull is deliberately non fatal, so
# the timer stays green while the checkout is frozen on an old commit forever.
# Measured on a throwaway repository, not feared.
#
# Write an id long enough to designate one task. An ambiguous one is reported
# and skipped, and the other ids in the message are still closed.
set -e

command -v jalon >/dev/null 2>&1 || exit 0

# Every message the pull brought in, not just the tip. One `git pull` routinely
# lands several merges, and reading HEAD alone closed the last one's task while
# the others stayed open with their work already on the branch.
#
# ORIG_HEAD is what the merge moved from. Without it there is no range to read,
# and a bare `git log HEAD` would walk the entire history and close every id
# ever written in a message, so the fallback stays at one commit.
if git rev-parse --verify --quiet ORIG_HEAD >/dev/null 2>&1; then
	git log ORIG_HEAD..HEAD --format=%B
else
	git log -1 --format=%B HEAD
fi | jalon close -from-merge
