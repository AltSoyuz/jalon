[Unit]
Description=jalon agent job for {{.Name}}
Documentation=https://github.com/AltSoyuz/jalon/blob/main/docs/agent.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{.User}}
WorkingDirectory={{.Repo}}

# A service does not inherit your shell's PATH, and this is the single most
# common reason a job that works by hand fails under systemd. Two things are
# usually missing: claude and gh in a user directory, and the toolchain the
# criterion needs. Check this line against `command -v` for every binary your
# criterion and probes actually run.
Environment=PATH={{.Jalon}}/bin:/home/{{.User}}/.local/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/{{.User}}

# One JSONL line per invocation, carrying the stamped version. With the job
# updating itself below, this is the only way to say afterwards which build
# produced which task.
Environment=JALON_METRICS=/home/{{.User}}/jalon-metrics.jsonl
{{- if .EnvFile}}

# Machine secrets, 0600 and owned by root. jalon references this file and never
# writes it, so the token never passes through a generated script.
EnvironmentFile={{.EnvFile}}
{{- end}}

# The job updates itself from the jalon checkout, which is not the target unless
# the target happens to be jalon. A merge is in production at the next tick and
# there is no second copy of the binary to keep in step. What you
# give up is choosing when the server changes version: you choose what, by
# merging, and the deployment follows within the hour.
#
# The leading - makes the pull non fatal: a network blip is journalled and the
# tick runs the code it already has, rather than failing hourly. --ff-only so a
# diverged checkout stops loudly instead of inventing a merge. The build has no
# -, because code that does not compile must not run.
#
# Absolute paths are required by systemd; check them against `command -v git
# make` if this is not Debian.
ExecStartPre=-/usr/bin/git -C {{.Jalon}} pull --ff-only
ExecStartPre=/usr/bin/make -C {{.Jalon}} build

# review runs doctor first and refuses on a red base, so a failure here is a
# real failure and not a half-finished job. The criterion is still the gate: a
# main that compiles but fails its tests blocks the job.
ExecStart={{.Jalon}}/bin/jalon review -next

# The job is bounded by max_budget_usd_per_job and timeout_seconds in
# .jalon/agent.toml; this is the outer bound for a process that ignores both.
TimeoutStartSec=3600

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{.Repo}} {{.Jalon}} /home/{{.User}}

[Install]
WantedBy=multi-user.target
