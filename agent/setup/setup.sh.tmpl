#!/bin/sh
# Generated by jalon agent-init ({{.Version}}). Read it before you run it.
#
#   sh setup.sh              runs the unprivileged part only
#   sudo sh setup.sh --root  runs the root part only
#
# Nothing here is idempotent in the way a configuration tool would be: it runs
# a handful of times over the life of a machine and a person reads the output.
set -eu

REPO={{quote .Repo}}
USER={{quote .User}}

if [ "${1-}" = "--root" ]; then
  # ---------- ROOT ----------
  # The only part that needs privilege, and the only part jalon will not do for
  # you. The agent user gets no sudo: that absence is what makes production a
  # structural gate rather than a promise.
  id "$USER" >/dev/null 2>&1 || useradd --system --create-home --shell /usr/sbin/nologin "$USER"

  cat > /etc/systemd/system/jalon-agent.service <<'UNIT'
{{template "jalon-agent.service.tmpl" .}}
UNIT

  cat > /etc/systemd/system/jalon-agent.timer <<'UNIT'
{{template "jalon-agent.timer.tmpl" .}}
UNIT

  systemctl daemon-reload
  systemctl enable --now jalon-agent.timer
  echo "installed. next runs:"
  systemctl list-timers jalon-agent.timer --no-pager
  exit 0
fi

# ---------- UNPRIVILEGED ----------
cd "$REPO"
mkdir -p {{quote .ConfigDir}}

cat > {{quote .Config}} <<'TOML'
{{template "agent.toml.tmpl" .}}
TOML

echo "wrote {{.Config}}"
echo
echo "Now, in order:"
echo "  1. \$EDITOR {{.Config}}          the probes are a guess, the criterion may be wrong"
echo "  2. jalon doctor                        every check must pass"
echo "  3. jalon review <issue>                one real job, watched"
echo
echo "Only once that has worked twice:"
echo "  sudo sh $0 --root"
echo
echo "The agent user needs its own model credentials; yours live in your home"
echo "and it cannot read them. As $USER, run: claude setup-token"
echo "Reverting: systemctl disable --now jalon-agent.timer && rm /etc/systemd/system/jalon-agent.*"
